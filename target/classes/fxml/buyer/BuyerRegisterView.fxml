<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hkust.marketplace.controllers.buyer.BuyerRegisterController"
           styleClass="welcome-bg" prefWidth="1200" prefHeight="780">

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox alignment="CENTER" spacing="0" maxWidth="460" style="-fx-padding: 30 0;">
            <VBox alignment="CENTER" spacing="14" styleClass="auth-pane">
                <HBox alignment="CENTER" spacing="12">
                    <ImageView fitHeight="46" fitWidth="30" preserveRatio="true">
                        <image>
                            <Image url="@../../images/hkust_logo.png"/>
                        </image>
                    </ImageView>
                    <Label text="Buyer Registration" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #003974;"/>
                </HBox>

                <VBox spacing="5">
                    <Label text="Username *" style="-fx-font-weight: 600;"/>
                    <TextField fx:id="usernameField" promptText="Unique username" prefHeight="38"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Full Name *" style="-fx-font-weight: 600;"/>
                    <TextField fx:id="fullNameField" promptText="Your full name" prefHeight="38"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Password *" style="-fx-font-weight: 600;"/>
                    <PasswordField fx:id="passwordField" promptText="Min 8 chars, upper + lower + digit" prefHeight="38"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Confirm Password *" style="-fx-font-weight: 600;"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" prefHeight="38"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Residence Hall / Off-campus (optional)" style="-fx-font-weight: 600;"/>
                    <ComboBox fx:id="residenceCombo" promptText="Select or leave blank" prefHeight="38" maxWidth="Infinity"/>
                </VBox>

                <Label fx:id="errorLabel" text="" style="-fx-text-fill: #c62828; -fx-font-size: 13px;"
                       wrapText="true" managed="false" visible="false"/>
                <Label fx:id="successLabel" text="" style="-fx-text-fill: #2e7d32; -fx-font-size: 13px;"
                       wrapText="true" managed="false" visible="false"/>

                <Button text="Create Account" styleClass="btn-primary" onAction="#handleRegister"
                        prefWidth="Infinity" prefHeight="42"/>

                <HBox alignment="CENTER" spacing="6">
                    <Label text="Already registered?" style="-fx-text-fill: #5a5a7a;"/>
                    <Hyperlink text="Login here" onAction="#goLogin"/>
                </HBox>
                <Hyperlink text="← Back to Welcome" onAction="#goWelcome"/>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
