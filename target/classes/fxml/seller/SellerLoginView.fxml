<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hkust.marketplace.controllers.seller.SellerLoginController"
           styleClass="welcome-bg" prefWidth="1200" prefHeight="780">

    <VBox alignment="CENTER" spacing="0" maxWidth="420">
        <VBox alignment="CENTER" spacing="18" styleClass="auth-pane">
            <HBox alignment="CENTER" spacing="12">
                <ImageView fitHeight="50" fitWidth="34" preserveRatio="true">
                    <image>
                        <Image url="@../../images/hkust_logo.png"/>
                    </image>
                </ImageView>
                <Label text="Seller Login" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #A68137;"/>
            </HBox>

            <Label text="Sign in with your seller account"
                   style="-fx-text-fill: #5a5a7a; -fx-font-size: 13px;"/>

            <VBox spacing="6">
                <Label text="Username" style="-fx-font-weight: 600;"/>
                <TextField fx:id="usernameField" promptText="Enter username" prefHeight="40"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Password" style="-fx-font-weight: 600;"/>
                <PasswordField fx:id="passwordField" promptText="Enter password" prefHeight="40"/>
            </VBox>

            <Label fx:id="errorLabel" text="" style="-fx-text-fill: #c62828; -fx-font-size: 13px;"
                   wrapText="true" managed="false" visible="false"/>

            <Button text="Login" styleClass="btn-gold" onAction="#handleLogin"
                    prefWidth="Infinity" prefHeight="42"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Don't have an account?" style="-fx-text-fill: #5a5a7a;"/>
                <Hyperlink text="Register here" onAction="#goRegister"/>
            </HBox>
            <Hyperlink text="← Back to Welcome" onAction="#goWelcome"/>
        </VBox>
        <Label text="Demo credentials: charlie / password1"
               style="-fx-text-fill: #a0b8d0; -fx-font-size: 12px; -fx-padding: 12 0 0 0;"/>
    </VBox>
</StackPane>
